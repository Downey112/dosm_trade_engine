	partition fact_trade_headline = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(ProcessedFolder & "\fact_trade_headline.csv"),
				        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Typed" = Table.TransformColumnTypes(#"Promoted Headers", {
				        {"date", type date},
				        {"exports", type number},
				        {"exports_domestic", type number},
				        {"re_exports", type number},
				        {"imports", type number},
				        {"imports_retained", type number},
				        {"total", type number},
				        {"balance", type number},
				        {"exports_yoy_pct", type number},
				        {"imports_yoy_pct", type number},
				        {"exports_3m_ma", type number},
				        {"trade_balance_3m_ma", type number},
				        {"exports_yoy_zscore", type number},
				        {"is_export_anomaly", type logical}
				    }, "en-US")
				in
				    #"Typed"

