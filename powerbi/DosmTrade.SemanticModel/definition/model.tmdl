model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ProcessedFolder", "DimDate", "fact_trade_headline", "fact_trade_sitc", "dim_sitc"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimDate
ref table fact_trade_headline
ref table fact_trade_sitc
ref table dim_sitc

ref cultureInfo en-US

